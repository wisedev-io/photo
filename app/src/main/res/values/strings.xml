    <!-- Where the rules come from -->
    <string name="rules_sources_title">Where the rules come from</string>
    <string name="rules_sources_intro">The U.S. State Department sets the rules and makes the final decision. This app measures your photo, so its checks are estimates.</string>
    <string name="rules_origin_number">Official number</string>
    <string name="rules_origin_words">Official wording</string>
    <string name="rules_legend">Official number: printed by the State Department. Official wording: required in words only, so the exact limits we use are our own.</string>
    <string name="rules_stale">These rules were last checked %1$d months ago and may have changed. Open the official page before you enter.</string>

    <!-- Help -->
    <string name="help_title">Help</string>
    <string name="help_rules_title">The rules</string>
    <string name="help_rules_1">Square photo, %1$d–%2$d px, JPEG, %3$d KB or less</string>
    <string name="help_rules_2">Head height %1$d–%2$d%% of the photo; eyes %3$d–%4$d%% up from the bottom</string>
    <string name="help_rules_3">Both eyes open, neutral expression, looking straight at the camera</string>
    <string name="help_rules_4">Plain white or off-white background, no shadows</string>
    <string name="help_rules_5">No glasses (unless medically required), no hats or head coverings (unless religious or medical)</string>
    <string name="help_rules_6">Taken within the last 6 months and showing how you look now</string>
    <string name="help_rules_7">Color photo, one person only, no filters or retouching</string>
    <string name="help_tips_title">Tips for a great photo</string>
    <string name="help_tips_1">Stand about 1 meter from a white wall</string>
    <string name="help_tips_2">Face a window or lamp so the light is even, with no shadows</string>
    <string name="help_tips_3">Hold the phone at eye level</string>
    <string name="help_tips_4">Ask someone to help, or lean the phone on a stack of books</string>
    <string name="help_tips_5">Keep hair off your face and eyes</string>
    <string name="help_nofilter_title">No filters, no AI</string>
    <string name="help_nofilter_1">This app switches off the camera’s effects and vendor extensions (HDR looks, beauty and portrait modes) and never edits pixels — it only crops and resizes.</string>
    <string name="help_nofilter_2">Don’t use beauty apps, filters, “AI enhance” or portrait mode. Even small touch-ups can get an entry disqualified.</string>
    <string name="help_nofilter_3">Photos you upload are checked for AI and editing marks hidden in the file data.</string>
    <string name="help_kids_title">Babies and children</string>
    <string name="help_kids_1">Every family member needs their own photo, including each child under 21.</string>
    <string name="help_kids_2">Nobody else, and no toys or pacifiers, may be in the picture. For a baby, lay them on a plain white sheet and shoot from above.</string>
    <string name="help_kids_3">The same size and background rules apply. Try to catch the baby with both eyes open and a calm face.</string>
    <string name="help_cant_title">What the app can’t check</string>
    <string name="help_cant_1">Glasses, hats and head coverings</string>
    <string name="help_cant_2">The real age of a photo whose date was removed</string>
    <string name="help_cant_3">Subtle retouching done in other apps — only use unedited photos</string>
    <string name="help_open_entry">Open the DV entry website</string>
</resources>
