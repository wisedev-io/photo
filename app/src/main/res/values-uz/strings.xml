    <string name="rules_sources_title">Qoidalar qayerdan olingan</string>
    <string name="rules_sources_intro">Qoidalarni AQSh Davlat departamenti belgilaydi va yakuniy qarorni ham u chiqaradi. Ilova faqat rasmingizni oʻlchaydi, shuning uchun uning tekshiruvlari taxminiy.</string>
    <string name="rules_origin_number">Rasmiy raqam</string>
    <string name="rules_origin_words">Rasmiy matn</string>
    <string name="rules_legend">Rasmiy raqam — Davlat departamenti koʻrsatgan. Rasmiy matn — talab faqat soʻzlar bilan yozilgan, shuning uchun aniq chegaralarni oʻzimiz tanlaganmiz.</string>
    <string name="rules_stale">Bu qoidalar %1$d oy oldin tekshirilgan va oʻzgargan boʻlishi mumkin. Topshirishdan oldin rasmiy sahifani oching.</string>
    <string name="help_title">Yordam</string>
    <string name="help_rules_title">Qoidalar</string>
    <string name="help_rules_1">Kvadrat rasm, %1$d–%2$d px, JPEG, %3$d KB dan oshmasin</string>
    <string name="help_rules_2">Bosh balandligi rasmning %1$d–%2$d%%; koʻzlar pastdan %3$d–%4$d%% balandlikda</string>
    <string name="help_rules_3">Ikkala koʻz ochiq, oddiy yuz ifodasi, toʻgʻri kameraga qarang</string>
    <string name="help_rules_4">Oddiy oq yoki och fon, soyasiz</string>
    <string name="help_rules_5">Koʻzoynaksiz (tibbiy zarurat boʻlmasa), bosh kiyimsiz (diniy yoki tibbiy sabab boʻlmasa)</string>
    <string name="help_rules_6">Soʻnggi 6 oy ichida olingan va hozirgi qiyofangizni koʻrsatadi</string>
    <string name="help_rules_7">Rangli rasm, faqat bir kishi, filtr va retushsiz</string>
    <string name="help_tips_title">Yaxshi rasm uchun maslahatlar</string>
    <string name="help_tips_1">Oq devordan taxminan 1 metr narida turing</string>
    <string name="help_tips_2">Yorugʻlik tekis, soyasiz boʻlishi uchun deraza yoki chiroqqa qarab turing</string>
    <string name="help_tips_3">Telefonni koʻz balandligida ushlang</string>
    <string name="help_tips_4">Kimdandir yordam soʻrang yoki telefonni kitoblar ustiga suyang</string>
    <string name="help_tips_5">Sochlarni yuz va koʻzlardan chetga oling</string>
    <string name="help_nofilter_title">Filtrsiz, sunʼiy intellektsiz</string>
    <string name="help_nofilter_1">Ilova kamera effektlari va ishlab chiqaruvchi kengaytmalarini (HDR koʻrinish, chiroyli qilish va portret rejimlari) oʻchiradi va piksellarni hech qachon oʻzgartirmaydi — faqat kesadi va kichraytiradi.</string>
    <string name="help_nofilter_2">Chiroyli qilish ilovalari, filtrlar, «SI bilan yaxshilash» va portret rejimidan foydalanmang. Kichik retush ham arizani diskvalifikatsiya qilishi mumkin.</string>
    <string name="help_nofilter_3">Yuklangan rasmlar fayl maʼlumotlaridagi SI va tahrir belgilariga tekshiriladi.</string>
    <string name="help_kids_title">Chaqaloqlar va bolalar</string>
    <string name="help_kids_1">Oilaning har bir aʼzosiga, shu jumladan 21 yoshgacha boʻlgan har bir bolaga alohida rasm kerak.</string>
    <string name="help_kids_2">Rasmda boshqa odam, oʻyinchoq yoki emizik boʻlmasligi kerak. Chaqaloqni oddiy oq choyshabga yotqizib, yuqoridan suratga oling.</string>
    <string name="help_kids_3">Oʻlcham va fon qoidalari bir xil. Chaqaloqning ikkala koʻzi ochiq va yuzi xotirjam paytini poylashga harakat qiling.</string>
    <string name="help_cant_title">Ilova tekshira olmaydigan narsalar</string>
    <string name="help_cant_1">Koʻzoynak, shapka va bosh kiyimlar</string>
    <string name="help_cant_2">Sanasi olib tashlangan rasmning haqiqiy yoshi</string>
    <string name="help_cant_3">Boshqa ilovalarda qilingan sezilmas retush — faqat tahrirlanmagan rasmlardan foydalaning</string>
    <string name="help_open_entry">DV roʻyxatdan oʻtish saytini ochish</string>
</resources>
